/* Modern Dark Theme for IP Scanner */

QMainWindow, QDialog {
    background-color: #12131c;
    color: #e2e8f0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
}

QWidget {
    color: #e2e8f0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

QFrame#controlCard, QFrame#optionsBar, QFrame#filterBar, QFrame#detailsCard {
    background-color: #1a1b26;
    border: 1px solid #282a36;
    border-radius: 8px;
}

QLabel {
    color: #cbd5e1;
}

/* Inputs & Combos */
QLineEdit, QComboBox, QSpinBox {
    background-color: #24283b;
    border: 1px solid #3b4261;
    border-radius: 6px;
    padding: 6px 10px;
    color: #f8fafc;
    font-size: 13px;
    selection-background-color: #3b82f6;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #3b82f6;
    background-color: #282e46;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left-width: 0px;
}

QComboBox QAbstractItemView {
    background-color: #1f2335;
    border: 1px solid #3b4261;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
    padding: 4px;
    outline: 0px;
}

/* Buttons */
QPushButton {
    background-color: #24283b;
    border: 1px solid #3b4261;
    border-radius: 6px;
    padding: 6px 14px;
    color: #f1f5f9;
    font-weight: 500;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #2f354f;
    border-color: #4b557c;
}

QPushButton:pressed {
    background-color: #1e2233;
}

QPushButton#primaryBtn, QPushButton#scanBtnActive {
    background-color: #2563eb;
    border: 1px solid #1d4ed8;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#primaryBtn:hover {
    background-color: #1d4ed8;
}

QPushButton#scanBtnActive {
    background-color: #dc2626;
    border-color: #b91c1c;
}

QPushButton#scanBtnActive:hover {
    background-color: #b91c1c;
}

/* Checkboxes */
QCheckBox {
    spacing: 7px;
    color: #cbd5e1;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border-radius: 4px;
    border: 1px solid #3b4261;
    background-color: #24283b;
}

QCheckBox::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
    image: none;
}

/* Badges */
QLabel.badge {
    background-color: #24283b;
    border: 1px solid #3b4261;
    border-radius: 12px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#aliveBadge {
    color: #34d399;
    background-color: #064e3b;
    border: 1px solid #059669;
}

QLabel#offlineBadge {
    color: #94a3b8;
    background-color: #1e293b;
    border: 1px solid #334155;
}

QLabel#totalBadge {
    color: #60a5fa;
    background-color: #1e3a8a;
    border: 1px solid #2563eb;
}

QLabel#timeBadge {
    color: #fbbf24;
    background-color: #451a03;
    border: 1px solid #b45309;
}

/* Table View */
QTableView, QTableWidget {
    background-color: #181924;
    alternate-background-color: #1e202e;
    border: 1px solid #2a2e45;
    border-radius: 8px;
    gridline-color: #282c40;
    selection-background-color: #2b3a5b;
    selection-color: #ffffff;
    outline: none;
}

QTableView::item {
    padding: 6px 8px;
    border: none;
}

QTableView::item:selected {
    background-color: #2d3e66;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #1f2335;
    color: #94a3b8;
    font-weight: 600;
    font-size: 12px;
    padding: 8px 10px;
    border: none;
    border-right: 1px solid #2a2e45;
    border-bottom: 2px solid #3b4261;
}

QHeaderView::section:hover {
    background-color: #24283b;
    color: #f1f5f9;
}

/* Progress Bar */
QProgressBar {
    background-color: #1f2335;
    border: 1px solid #2f334d;
    border-radius: 6px;
    text-align: center;
    color: #f8fafc;
    font-size: 11px;
    font-weight: 600;
    height: 18px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3b82f6, stop:1 #06b6d4);
    border-radius: 5px;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #181924;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #3b4261;
    min-height: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4c5680;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #181924;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #3b4261;
    min-width: 24px;
    border-radius: 5px;
    margin: 2px;
}

/* Menu */
QMenuBar {
    background-color: #12131c;
    color: #cbd5e1;
    border-bottom: 1px solid #2a2e45;
}

QMenuBar::item:selected {
    background-color: #24283b;
    color: #ffffff;
}

QMenu {
    background-color: #1f2335;
    border: 1px solid #3b4261;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #3b82f6;
    color: #ffffff;
}

QStatusBar {
    background-color: #12131c;
    color: #94a3b8;
    border-top: 1px solid #2a2e45;
}
