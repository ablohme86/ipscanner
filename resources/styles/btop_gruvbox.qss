/* ===================================================================
   BTOP // GRUVBOX DARK THEME
   Warm retro terminal with aqua, orange, yellow, green, and red
   =================================================================== */

* {
    font-family: "Hack", "DejaVu Sans Mono", "Liberation Mono", "Noto Sans Mono", "Courier New", monospace;
    font-size: 12px;
}

QMainWindow, QDialog {
    background-color: #1d2021;
    color: #ebdbb2;
    border: 1px solid #3c3836;
}

QWidget {
    background-color: #1d2021;
    color: #ebdbb2;
}

/* Control Cards and Framed Panels */
QFrame#controlCard {
    background-color: #282828;
    border: 1px solid #8ec07c;
    border-radius: 4px;
}

QFrame#filterBar {
    background-color: #282828;
    border: 1px solid #fabd2f;
    border-radius: 4px;
}

QFrame#detailsCard, QFrame#terminalFrame {
    background-color: #282828;
    border: 1px solid #504945;
    border-radius: 4px;
}

QFrame#controlCard:hover {
    border: 1px solid #b8bb26;
}

QFrame#filterBar:hover {
    border: 1px solid #fe8019;
}

QLabel {
    color: #ebdbb2;
    background-color: transparent;
}

QLabel#titleBanner {
    color: #8ec07c;
    font-weight: bold;
    font-size: 12px;
    letter-spacing: 0.5px;
}

/* Text Inputs, Combos, SpinBoxes */
QLineEdit, QComboBox, QSpinBox {
    background-color: #1b1b1b;
    border: 1px solid #504945;
    border-radius: 3px;
    padding: 5px 8px;
    color: #8ec07c;
    font-weight: bold;
    selection-background-color: #504945;
    selection-color: #ebdbb2;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #8ec07c;
    background-color: #282828;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid #504945;
}

QComboBox QAbstractItemView {
    background-color: #282828;
    border: 1px solid #8ec07c;
    selection-background-color: #504945;
    selection-color: #8ec07c;
    outline: none;
    color: #ebdbb2;
    padding: 4px;
}

/* Push Buttons */
QPushButton {
    background-color: #32302f;
    border: 1px solid #504945;
    border-radius: 3px;
    padding: 5px 12px;
    color: #ebdbb2;
    font-weight: bold;
    text-transform: uppercase;
}

QPushButton:hover {
    background-color: #3c3836;
    border-color: #8ec07c;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #504945;
    border-color: #fabd2f;
}

QPushButton:disabled {
    color: #7c6f64;
    border-color: #32302f;
    background-color: #1b1b1b;
}

/* Primary Execution Button (Scan) */
QPushButton#primaryBtn {
    background-color: #b8bb26;
    border: 1px solid #b8bb26;
    color: #1d2021;
    font-weight: bold;
}

QPushButton#primaryBtn:hover {
    background-color: #d5d85c;
    border-color: #ffffff;
    color: #1d2021;
}

/* Active Abort Button */
QPushButton#scanBtnActive {
    background-color: #fb4934;
    border: 1px solid #fb4934;
    color: #1d2021;
    font-weight: bold;
}

QPushButton#scanBtnActive:hover {
    background-color: #ff6854;
    color: #ffffff;
}

/* Specialized Tool Buttons */
QPushButton#portScanBtn {
    border: 1px solid #fe8019;
    color: #fe8019;
    background-color: #32251e;
}
QPushButton#portScanBtn:hover {
    background-color: #4a3426;
    color: #ffffff;
}

QPushButton#wolBtn {
    border: 1px solid #fabd2f;
    color: #fabd2f;
    background-color: #342e1d;
}
QPushButton#wolBtn:hover {
    background-color: #4d4323;
    color: #ffffff;
}

QPushButton#exportBtn {
    border: 1px solid #d3869b;
    color: #d3869b;
    background-color: #32232c;
}
QPushButton#exportBtn:hover {
    background-color: #48303d;
    color: #ffffff;
}

QPushButton#refreshBtn {
    border: 1px solid #8ec07c;
    color: #8ec07c;
    background-color: #1f2d29;
}
QPushButton#refreshBtn:hover {
    background-color: #2b423a;
    color: #ffffff;
}

QPushButton#pauseBtn {
    border: 1px solid #fabd2f;
    color: #fabd2f;
    background-color: #342e1d;
}

QPushButton#clearBtn {
    border: 1px solid #fb4934;
    color: #fb4934;
    background-color: #361f1f;
}

QPushButton#btnHttp, QPushButton#btnHttps {
    border: 1px solid #8ec07c;
    color: #8ec07c;
    background-color: #1f2d29;
}
QPushButton#btnHttp:hover, QPushButton#btnHttps:hover {
    background-color: #2b423a;
    color: #ffffff;
}

QPushButton#btnSsh {
    border: 1px solid #b8bb26;
    color: #b8bb26;
    background-color: #232a1e;
}
QPushButton#btnSsh:hover {
    background-color: #333d2a;
    color: #ffffff;
}

QPushButton#btnPing {
    border: 1px solid #fabd2f;
    color: #fabd2f;
    background-color: #342e1d;
}
QPushButton#btnPing:hover {
    background-color: #4d4323;
    color: #ffffff;
}

QPushButton#btnPortScan {
    border: 1px solid #fe8019;
    color: #fe8019;
    background-color: #32251e;
}
QPushButton#btnPortScan:hover {
    background-color: #4a3426;
    color: #ffffff;
}

QPushButton#btnWol {
    border: 1px solid #d3869b;
    color: #d3869b;
    background-color: #32232c;
}
QPushButton#btnWol:hover {
    background-color: #48303d;
    color: #ffffff;
}

QPushButton#btnCopy {
    border: 1px solid #a89984;
    color: #ebdbb2;
    background-color: #282828;
}
QPushButton#btnCopy:hover {
    background-color: #3c3836;
    color: #ffffff;
}

/* Checkboxes */
QCheckBox {
    spacing: 6px;
    color: #ebdbb2;
    background-color: transparent;
    font-weight: bold;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #504945;
    background-color: #1b1b1b;
    border-radius: 2px;
}

QCheckBox::indicator:checked {
    background-color: #8ec07c;
    border-color: #8ec07c;
}

/* Telemetry Badges */
QLabel.badge {
    border-radius: 3px;
    padding: 4px 10px;
    font-weight: bold;
    font-size: 11px;
}

QLabel#aliveBadge {
    color: #b8bb26;
    background-color: #232a1e;
    border: 1px solid #b8bb26;
}

QLabel#offlineBadge {
    color: #fb4934;
    background-color: #361f1f;
    border: 1px solid #fb4934;
}

QLabel#totalBadge {
    color: #8ec07c;
    background-color: #1f2d29;
    border: 1px solid #8ec07c;
}

QLabel#timeBadge {
    color: #fabd2f;
    background-color: #342e1d;
    border: 1px solid #fabd2f;
}

/* Discovered Node Matrix (Table) */
QTableView, QTableWidget {
    background-color: #1b1b1b;
    alternate-background-color: #242424;
    border: 1px solid #504945;
    border-radius: 4px;
    gridline-color: #32302f;
    selection-background-color: #504945;
    selection-color: #ffffff;
    color: #ebdbb2;
    outline: none;
}

QTableView::item {
    padding: 5px 6px;
    border: none;
}

QTableView::item:selected {
    background-color: #504945;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #282828;
    color: #fabd2f;
    font-weight: bold;
    font-size: 11px;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid #3c3836;
    border-bottom: 2px solid #8ec07c;
}

QHeaderView::section:hover {
    background-color: #3c3836;
    color: #ffffff;
}

/* Chunky Multi-Color Gradient Progress Bar */
QProgressBar {
    background-color: #1b1b1b;
    border: 1px solid #504945;
    border-radius: 3px;
    text-align: center;
    color: #ffffff;
    font-size: 11px;
    font-weight: bold;
    height: 18px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0.0 #b8bb26,
        stop:0.3 #8ec07c,
        stop:0.6 #fabd2f,
        stop:0.85 #fe8019,
        stop:1.0 #fb4934);
    border-radius: 2px;
}

/* Terminal Log Stream */
QTextEdit#terminalLog {
    background-color: #181818;
    border: 1px solid #504945;
    border-radius: 3px;
    color: #ebdbb2;
    font-size: 11px;
    line-height: 1.35;
    selection-background-color: #504945;
    selection-color: #ffffff;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #8ec07c;
    background-color: #282828;
    border-radius: 3px;
    top: -1px;
}

QTabBar::tab {
    background-color: #1d2021;
    color: #928374;
    border: 1px solid #504945;
    border-bottom: none;
    padding: 6px 14px;
    font-weight: bold;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #282828;
    color: #8ec07c;
    border: 1px solid #8ec07c;
    border-bottom: 2px solid #282828;
}

QTabBar::tab:hover:!selected {
    color: #ebdbb2;
    background-color: #32302f;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #181818;
    width: 10px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #504945;
    min-height: 20px;
    border-radius: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #8ec07c;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0px;
}

QScrollBar::horizontal {
    background: #181818;
    height: 10px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #504945;
    min-width: 20px;
    border-radius: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #8ec07c;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0px;
}

/* Status Bar & Menu Bar */
QStatusBar {
    background-color: #1b1b1b;
    color: #8ec07c;
    border-top: 1px solid #32302f;
    font-weight: bold;
    font-size: 11px;
}

QMenuBar {
    background-color: #1b1b1b;
    color: #ebdbb2;
    border-bottom: 1px solid #32302f;
    padding: 2px;
}

QMenuBar::item:selected {
    background-color: #504945;
    color: #fabd2f;
}

QMenu {
    background-color: #282828;
    color: #ebdbb2;
    border: 1px solid #8ec07c;
}

QMenu::item:selected {
    background-color: #504945;
    color: #fabd2f;
}

QMenu::separator {
    height: 1px;
    background-color: #3c3836;
    margin: 4px 0px;
}

QToolTip {
    background-color: #282828;
    color: #fabd2f;
    border: 1px solid #8ec07c;
    padding: 4px 6px;
    font-size: 11px;
}
