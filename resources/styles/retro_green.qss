/* ===================================================================
   RETRO HACKER / MATRIX PHOSPHOR GREEN THEME (TERMINAL CRT)
   =================================================================== */

* {
    font-family: "Hack", "DejaVu Sans Mono", "Liberation Mono", "Noto Sans Mono", "Courier New", monospace;
    font-size: 12px;
}

QMainWindow, QDialog {
    background-color: #060a06;
    color: #00ff66;
    border: 1px solid #004414;
}

QWidget {
    background-color: #060a06;
    color: #00ff66;
}

/* Control Cards and Frames */
QFrame#controlCard, QFrame#filterBar, QFrame#detailsCard, QFrame#terminalFrame {
    background-color: #090f09;
    border: 1px solid #00882b;
    border-radius: 2px;
}

QFrame#controlCard:hover, QFrame#filterBar:hover, QFrame#detailsCard:hover {
    border: 1px solid #00ff66;
}

QLabel {
    color: #00ff66;
    background-color: transparent;
}

QLabel#titleBanner {
    color: #33ff77;
    font-weight: bold;
    font-size: 13px;
    letter-spacing: 1px;
}

/* Text Inputs, Combos, SpinBoxes */
QLineEdit, QComboBox, QSpinBox {
    background-color: #030603;
    border: 1px solid #007722;
    border-radius: 1px;
    padding: 5px 8px;
    color: #00ff66;
    font-weight: bold;
    selection-background-color: #004414;
    selection-color: #33ff77;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #00ff66;
    background-color: #081208;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #005518;
}

QComboBox QAbstractItemView {
    background-color: #050a05;
    border: 1px solid #00aa33;
    selection-background-color: #004414;
    selection-color: #33ff77;
    outline: none;
    color: #00ff66;
}

/* Push Buttons (Hacker Macro Keys) */
QPushButton {
    background-color: #081008;
    border: 1px solid #00882b;
    border-radius: 1px;
    padding: 5px 12px;
    color: #00ff66;
    font-weight: bold;
    text-transform: uppercase;
}

QPushButton:hover {
    background-color: #00280c;
    border-color: #00ff66;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #004414;
    border-color: #33ff77;
}

QPushButton:disabled {
    color: #004414;
    border-color: #00280c;
    background-color: #040604;
}

/* Primary Execution Button (Scan) */
QPushButton#primaryBtn {
    background-color: #003311;
    border: 1px solid #00ff66;
    color: #ffffff;
    font-weight: bold;
}

QPushButton#primaryBtn:hover {
    background-color: #004d1a;
    border-color: #33ff77;
    color: #ffffff;
}

/* Active Abort Button */
QPushButton#scanBtnActive {
    background-color: #2b0505;
    border: 1px solid #ff3333;
    color: #ff6666;
    font-weight: bold;
}

QPushButton#scanBtnActive:hover {
    background-color: #4d0a0a;
    color: #ffffff;
}

/* Checkboxes */
QCheckBox {
    spacing: 6px;
    color: #00ff66;
    background-color: transparent;
    font-weight: bold;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #00882b;
    background-color: #030603;
    border-radius: 1px;
}

QCheckBox::indicator:checked {
    background-color: #00ff66;
    border-color: #00ff66;
}

/* Telemetry Badges */
QLabel.badge {
    border: 1px solid #00882b;
    border-radius: 1px;
    padding: 3px 8px;
    font-weight: bold;
    font-size: 11px;
}

QLabel#aliveBadge {
    color: #00ff66;
    background-color: #021a08;
    border: 1px solid #00aa33;
}

QLabel#offlineBadge {
    color: #006622;
    background-color: #030a03;
    border: 1px solid #004414;
}

QLabel#totalBadge {
    color: #33ff88;
    background-color: #00220c;
    border: 1px solid #00882b;
}

QLabel#timeBadge {
    color: #ffb000;
    background-color: #1a1000;
    border: 1px solid #885500;
}

/* Main Table View */
QTableView, QTableWidget {
    background-color: #030503;
    alternate-background-color: #070c07;
    border: 1px solid #007722;
    gridline-color: #00280c;
    selection-background-color: #003610;
    selection-color: #ffffff;
    color: #00ff66;
    outline: none;
}

QTableView::item {
    padding: 5px 6px;
    border: none;
}

QTableView::item:selected {
    background-color: #004414;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #071007;
    color: #00ff66;
    font-weight: bold;
    font-size: 11px;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid #003311;
    border-bottom: 2px solid #00aa33;
}

QHeaderView::section:hover {
    background-color: #0c1c0c;
    color: #ffffff;
}

/* Progress Bar (CRT Phosphor Style) */
QProgressBar {
    background-color: #030603;
    border: 1px solid #00882b;
    border-radius: 1px;
    text-align: center;
    color: #00ff66;
    font-size: 11px;
    font-weight: bold;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #00ff66;
}

/* Terminal Log Stream */
QTextEdit#terminalLog {
    background-color: #020402;
    border: 1px solid #006622;
    border-radius: 1px;
    color: #00ff66;
    font-size: 11px;
    line-height: 1.3;
    selection-background-color: #004414;
    selection-color: #ffffff;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #030603;
    width: 10px;
    margin: 0px;
    border-left: 1px solid #003311;
}

QScrollBar::handle:vertical {
    background-color: #005518;
    min-height: 20px;
    border-radius: 1px;
}

QScrollBar::handle:vertical:hover {
    background-color: #00aa33;
}

QScrollBar:horizontal {
    background-color: #030603;
    height: 10px;
    margin: 0px;
    border-top: 1px solid #003311;
}

QScrollBar::handle:horizontal {
    background-color: #005518;
    min-width: 20px;
    border-radius: 1px;
}

/* Tab Widget (Hacker Tabs) */
QTabWidget::pane {
    border: 1px solid #00882b;
    background-color: #060a06;
}

QTabBar::tab {
    background-color: #071007;
    color: #009933;
    border: 1px solid #004414;
    padding: 6px 14px;
    font-weight: bold;
    border-bottom: none;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #0c180c;
    color: #00ff66;
    border: 1px solid #00aa33;
    border-bottom: 1px solid #0c180c;
}

QTabBar::tab:hover {
    color: #33ff77;
    background-color: #091409;
}

/* Menu */
QMenuBar {
    background-color: #040604;
    color: #00cc44;
    border-bottom: 1px solid #004414;
}

QMenuBar::item:selected {
    background-color: #003311;
    color: #ffffff;
}

QMenu {
    background-color: #060a06;
    border: 1px solid #00aa33;
    padding: 2px;
}

QMenu::item {
    padding: 5px 20px;
    color: #00ff66;
}

QMenu::item:selected {
    background-color: #004414;
    color: #ffffff;
}

QStatusBar {
    background-color: #040604;
    color: #00aa33;
    border-top: 1px solid #003311;
    font-size: 11px;
}
